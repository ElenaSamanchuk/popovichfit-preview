.cookieBanner');\n    if (!banner) return;\n    banner.classList.remove('visible');\n    banner.classList.add('hidden');\n    document.removeEventListener('click', handleGlobalClick, true);\n    setTimeout(function() {\n      banner.style.display = 'none';\n    }, 400);\n  }\n  function showBanner() {\n    var banner = document.querySelector('.cookieBanner');\n    if (!banner) return;\n    banner.style.display = 'block';\n    setTimeout(function() {\n      banner.classList.add('visible');\n    }, 10);\n  }\n  function isPolicyLinkClick(element) {\n    var current = element;\n    while (current && current !== document.body) {\n      if (current.classList && current.classList.contains('cookie-banner-link')) {\n        return true;\n      }\n      current = current.parentElement;\n    }\n    return false;\n  }\n  function handleGlobalClick(event) {\n    if (isPolicyLinkClick(event.target)) {\n      return;\n    }\n    saveConsent();\n    hideBanner();\n  }\n  function init() {\n    if (isInitialized) return;\n    isInitialized = true;\n    var banner = document.querySelector('.cookieBanner');\n    if (!banner) return;\n    if (checkConsent()) {\n      banner.style.display = 'none';\n    } else {\n      showBanner();\n      document.addEventListener('click', handleGlobalClick, true);\n    }\n  }\n  if (document.readyState === 'loading') {\n    document.addEventListener('DOMContentLoaded', init);\n  } else {\n    setTimeout(init, 100);\n  }\n})();\n\u003C\u002Fscript>",{"id":235,"type":8,"vis":236,"bg":10,"pad":237,"uc":238,"hooks":239,"popupRecs":240,"custom":241},"rec828337470",{"min":10,"max":10},{"padding-top":10,"padding-bottom":10},[],[],[],"\u003Cscript>\ndocument.addEventListener(\"DOMContentLoaded\", function () {\n    \u002F\u002F Определяем текущий URL\n    const urlParams = new URLSearchParams(window.location.search);\n    const rParam = urlParams.get('r'); \u002F\u002F Получаем значение параметра r\n\n    \u002F\u002F Если параметр r присутствует\n    if (rP