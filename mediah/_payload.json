rec602944849 .t-text{font-family:'Manrope';}",[],[],{"id":362,"type":61,"vis":363,"bg":10,"pad":364,"uc":365,"html":366,"hooks":367,"popupRecs":368},"rec602947087",{"min":10,"max":10},{"padding-top":247,"padding-bottom":247},[],"\u003Cdiv class=\"t107\"> \u003Cdiv class=\"t-align_center\" itemscope itemtype=\"http:\u002F\u002Fschema.org\u002FImageObject\"> \u003Cmeta itemprop=\"image\" content=\"\u002Fpopovichfit-preview\u002Fimg\u002Ft\u002Ft37616537-frame_1.webp\"> \u003Cimg class=\"t-img t-width t107__width t-width_8\" src=\"\u002Fpopovichfit-preview\u002Fimg\u002Ft\u002Ft37616537-frame_1.webp\" imgfield=\"img\" data-zoomable=\"yes\" data-img-zoom-url=\"images\u002Ftild3761-6537-4965-b530-313833636263__frame_1.png\" alt=\"\"> \u003C\u002Fdiv> \u003C\u002Fdiv>",[],[],{"id":370,"type":352,"vis":371,"bg":10,"pad":372,"uc":373,"html":374,"css":375,"hooks":376,"popupRecs":377},"rec602947048",{"min":10,"max":10},{"padding-top":355,"padding-bottom":355},[],"\u003Cdiv class=\"t004\"> \u003Cdiv class=\"t-container \"> \u003Cdiv class=\"t-col t-col_8 t-prefix_2\"> \u003Cdiv field=\"text\" class=\"t-text t-text_md \">\u003Cspan style=\"font-weight: 300;\">В данном варианте верхне-грудной отдел практически обездвижен и любые попытки «расправить плечи» (а сделать это хочется постоянно, потому что человек испытывает перманентное напряжение и дискомфорт в районе шеи) приводят к тому, что голова ещё больше запрокидывается назад, а в районе поясницы формируется прогиб. Это приводит и к «выпирающему» животу, и болям в районе спины.\u003C\u002Fspan>\u003C\u002Fdiv> \u003C\u002Fdiv> \u003C\u002Fdiv> \u003C\u002Fdiv>","#rec602947048 .t-text{font-family:'Manrope';}",[],[],{"id":379,"type":61,"vis":380,"bg":10,"pad":381,"uc":382,"html":383,"hooks":384,"popupRecs":385},"rec602944850",{"min":10,"max":10},{"padding-top":247,"padding-bottom":247},[],"\u003Cdiv class=\"t107\"> \u003Cdiv class=\"t-align_center\" itemscope itemtype=\"http:\u002F\u002Fschema.org\u002FImageObject\"> \u003Cmeta 